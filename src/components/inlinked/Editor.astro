---
import { 
    Bold, 
    Italic, 
    Underline, 
    Strikethrough, 
    Code, 
    Feather, 
    Scroll, 
    Type, 
    Eraser, 
    Copy, 
    Trash2,
    CheckCircle2
} from 'lucide-astro';

interface Props {
    platform?: 'linkedin' | 'x';
}

const { platform = 'linkedin' } = Astro.props;
---
<!-- Import Quill Styles -->
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

<div class="editor-wrapper" data-platform={platform}>
  <!-- Ribbon Toolbar -->
  <div id="toolbar" class="ribbon-toolbar">
    
    <!-- Standard Formatting Group -->
    <div class="ribbon-group">
        <span class="group-label" data-i18n="inlinked.format_group">Formato</span>
        <div class="group-content">
            <button class="format-btn ribbon-btn" data-format="bold" title="Negrita" data-i18n-tooltip="inlinked.bold">
                <div class="icon-box"><Bold class="icon" /></div>
                <span class="label" data-i18n="inlinked.bold">Negrita</span>
            </button>
            <button class="format-btn ribbon-btn" data-format="italic" title="Cursiva" data-i18n-tooltip="inlinked.italic">
                <div class="icon-box"><Italic class="icon" /></div>
                <span class="label" data-i18n="inlinked.italic">Cursiva</span>
            </button>
            <button class="format-btn ribbon-btn" data-format="underline" title="Subrayado" data-i18n-tooltip="inlinked.underline">
                <div class="icon-box"><Underline class="icon" /></div>
                <span class="label" data-i18n="inlinked.underline">Subr.</span>
            </button>
            <button class="format-btn ribbon-btn" data-format="strike" title="Tachado" data-i18n-tooltip="inlinked.strikethrough">
                <div class="icon-box"><Strikethrough class="icon" /></div>
                <span class="label" data-i18n="inlinked.strikethrough">Tachado</span>
            </button>
            <button class="format-btn ribbon-btn" data-format="code" title="Código" data-i18n-tooltip="inlinked.code">
                <div class="icon-box"><Code class="icon" /></div>
                <span class="label" data-i18n="inlinked.code">Código</span>
            </button>
        </div>
    </div>

    <!-- Separator -->
    <div class="separator"></div>

    <!-- Custom Fonts Group -->
    <div class="ribbon-group">
        <span class="group-label" data-i18n="inlinked.linkedin_group">Estilos LinkedIn</span>
        <div class="group-content">
            <button class="custom-btn ribbon-btn" data-variant="script" title="Script">
                <div class="icon-box"><Feather class="icon" /></div>
                <span class="label">Script</span>
            </button>
            <button class="custom-btn ribbon-btn" data-variant="gothic" title="Gothic">
                <div class="icon-box"><Scroll class="icon" /></div>
                <span class="label">Gothic</span>
            </button>
            <button class="custom-btn ribbon-btn" data-variant="doublestruck" title="Double">
                <div class="icon-box"><Type class="icon" /></div>
                <span class="label">Double</span>
            </button>
        </div>
    </div>

    {platform === 'x' && (
    <!-- Separator -->
    <div class="separator"></div>

    <!-- Platform Settings Group -->
    <div class="ribbon-group">
        <span class="group-label" data-i18n="inx.char_limit">Límite</span>
        <div class="group-content">
            <button id="proToggle" class="ribbon-btn" title="Activar modo Pro" data-i18n-tooltip="inx.pro_user">
                <div class="icon-box"><CheckCircle2 class="icon" /></div>
                <span class="label" data-i18n="inx.pro_user">Usuario Pro</span>
            </button>
        </div>
    </div>
    )}

    <!-- Separator -->
    <div class="separator"></div>

    <!-- Actions Group -->
    <div class="ribbon-group">
        <span class="group-label" data-i18n="inlinked.actions_group">Acciones</span>
        <div class="group-content">
            <button class="format-btn ribbon-btn" data-format="clean" title="Limpiar" data-i18n-tooltip="inlinked.clean">
                <div class="icon-box"><Eraser class="icon" /></div>
                <span class="label" data-i18n="inlinked.clean">Limpiar</span>
            </button>
            
            <button id="clearBtn" class="ribbon-btn danger" title="Borrar Todo" data-i18n-tooltip="inlinked.clear">
                <div class="icon-box"><Trash2 class="icon" /></div>
                <span class="label" data-i18n="inlinked.clear">Borrar</span>
            </button>
            
            <button id="copyBtn" class="ribbon-btn primary" title="Copiar a LinkedIn" data-i18n-tooltip="inlinked.copy">
                <div class="icon-box" id="copyIconBox"><Copy class="icon" /></div>
                <span class="label" id="copyLabel" data-i18n="inlinked.copy">Copiar</span>
            </button>
        </div>
    </div>
  </div>

  <div class="editor-content-area">
      <div id="editor" data-i18n-placeholder={platform === 'x' ? "inx.placeholder" : "inlinked.placeholder"}></div>
  </div>
  
  <div class="status-bar">
    <div class="status-info">
      <span id="wordCount">0 <span data-i18n="inx.words">palabras</span></span>
      <span class="status-sep">|</span>
      <span id="charCount">0 <span data-i18n="inx.characters">caracteres</span></span>
    </div>
    <div id="charLimitWarning" class="char-limit-warning hidden" data-i18n="inx.over_limit">
      Límite de caracteres superado
    </div>
  </div>
</div>

<style>
  .editor-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 420px;
    overflow: hidden;
    background: var(--office-surface, #ffffff);
    border: 1px solid var(--office-line, #e1dfdd);
    border-radius: var(--office-radius, 4px);
    box-shadow: var(--office-shadow, 0 1px 2px rgba(0, 0, 0, 0.08));
  }

  .ribbon-toolbar {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    padding: 8px 12px;
    overflow-x: auto;
    background: var(--office-paper, #faf9f8);
    border-bottom: 1px solid var(--office-line, #e1dfdd);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ribbon-toolbar::-webkit-scrollbar {
    display: none;
  }

  .ribbon-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: max-content;
  }

  .group-label {
    margin-bottom: 2px;
    color: var(--office-ink-4, #8a8886);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .group-content {
    display: flex;
    align-items: flex-start;
    gap: 2px;
  }

  .separator {
    width: 1px;
    align-self: stretch;
    margin: 4px 0;
    background: var(--office-line, #e1dfdd);
  }

  #toolbar .ribbon-btn {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-width: 58px;
    height: auto !important;
    width: auto !important;
    padding: 6px 8px;
    float: none !important;
    border: none;
    border-radius: var(--office-radius, 4px);
    background: transparent;
    color: var(--office-ink-2, #484644);
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  #toolbar .ribbon-btn:hover {
    background: var(--office-surface-2, #f3f2f1);
    color: var(--office-ink, #201f1e);
  }

  #toolbar .ribbon-btn.ql-active,
  #toolbar .ribbon-btn.active,
  #toolbar .ribbon-btn:active {
    background: var(--office-accent-soft, #ebf3fa);
    color: var(--office-accent, #0f6cbd);
  }

  #toolbar .ribbon-btn.active[id='proToggle'] {
    background: var(--office-accent-soft, #ebf3fa);
    color: var(--office-accent, #0f6cbd);
  }

  #toolbar .ribbon-btn.primary {
    background: var(--office-accent, #0f6cbd);
    color: #fff;
  }

  #toolbar .ribbon-btn.primary:hover {
    background: var(--office-accent-hover, #115ea3);
  }

  #toolbar .ribbon-btn.danger:hover {
    background: #fdecea;
    color: #a4262c;
  }

  #toolbar .icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
  }

  #toolbar .icon,
  #toolbar .icon-box svg {
    width: 20px;
    height: 20px;
    float: none !important;
    stroke-width: 1.8px;
  }

  .label {
    font-size: 11px;
    font-weight: 500;
    text-align: center;
    white-space: nowrap;
  }

  .editor-content-area {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 320px;
    background: var(--office-surface, #ffffff);
  }

  #editor {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px;
    border: none;
    color: var(--office-ink, #201f1e);
    font-family: var(--office-font, 'Segoe UI', sans-serif);
    font-size: 15px;
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px;
    background: var(--office-paper, #faf9f8);
    border-top: 1px solid var(--office-line, #e1dfdd);
    color: var(--office-ink-3, #605e5c);
    font-size: 11px;
  }

  .status-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-sep {
    color: var(--office-line-strong, #d2d0ce);
  }

  .char-limit-warning {
    color: #a4262c;
    font-weight: 600;
    animation: fadeIn 0.3s;
  }

  .char-limit-warning.hidden {
    display: none;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Overflow Highlight */
  :global(.ql-editor mark.ql-overflow) {
    background-color: #f4212e !important;
    color: #ffffff !important;
    border-bottom: 2px dotted white !important;
    display: inline !important;
  }

  /* Quill Overrides */
  .ql-toolbar.ql-snow {
    border: none !important;
    padding: 0 !important;
    font-family: inherit !important;
  }

  .ql-container.ql-snow {
    border: none !important;
    font-family: inherit !important;
  }

  .ql-editor {
    font-family: var(--office-font, 'Segoe UI', sans-serif);
    color: var(--office-ink, #201f1e);
  }

  .ql-editor.ql-blank::before {
    color: var(--office-ink-4, #8a8886) !important;
    font-style: normal !important;
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .ribbon-toolbar {
      gap: 0.5rem;
    }

    #toolbar .ribbon-btn {
      min-width: 44px;
      padding: 0.4rem;
    }

    .label {
      font-size: 10px;
    }

    .status-info span {
      font-size: 10px;
    }
  }
</style>

<script>
  console.log('InLinked/InX Editor Script Loaded');
  import Quill from 'quill';
  import { deltaToUnicode } from '../../utils/deltaToUnicode';
  import { toUnicodeVariant } from '../../utils/toUnicodeVariant';
  import { unicodeToAscii } from '../../utils/unicodeToAscii';

  // Register Custom Overflow Format
  const Inline = Quill.import('blots/inline');
  class OverflowBlot extends Inline {
    static blotName = 'overflow';
    static className = 'ql-overflow';
    static tagName = 'mark';
  }
  Quill.register(OverflowBlot);

  const wrapper = document.querySelector('.editor-wrapper') as HTMLElement;
  const platform = wrapper?.dataset.platform || 'linkedin';
  console.log('Platform detected:', platform);
  
  const charCount = document.getElementById('charCount');
  const wordCount = document.getElementById('wordCount');
  const charLimitWarning = document.getElementById('charLimitWarning');
  const copyBtn = document.getElementById('copyBtn');
  const copyLabel = document.getElementById('copyLabel');
  const copyIconBox = document.getElementById('copyIconBox');
  const clearBtn = document.getElementById('clearBtn');
  const proToggle = document.getElementById('proToggle');
  const customBtns = document.querySelectorAll('.custom-btn');
  const formatBtns = document.querySelectorAll('.format-btn');
  
  let isPro = false;
  const limits = {
      linkedin: 3000,
      x: 280,
      x_pro: 25000
  };

  function getCharLimit() {
      if (platform === 'linkedin') return limits.linkedin;
      return isPro ? limits.x_pro : limits.x;
  }

  // Wait for localization
  const getT = (key, defaultText) => {
      if (window.Localization) {
          return window.Localization.t(key);
      }
      return defaultText;
  };

  // Initialize Quill
  const quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
        toolbar: '#toolbar'
    },
    placeholder: platform === 'x' ? '¿Qué está pasando?' : 'Escribe aquí tu post para LinkedIn...'
  });
  
  // Apply placeholder from localization if available or listener
  const updatePlaceholder = () => {
       const ph = window.Localization.t(platform === 'x' ? 'inx.placeholder' : 'inlinked.placeholder');
       quill.root.dataset.placeholder = ph;
  };

  window.addEventListener('languageChanged', updatePlaceholder);
  if (window.Localization) updatePlaceholder();


  function updateCounts() {
    const text = quill.getText();
    const length = Math.max(0, text.length - 1);
    const words = text.trim() ? text.trim().split(/\s+/).filter(w => w.length > 0).length : 0;
    const limit = getCharLimit();

    console.log(`Counts - Length: ${length}, Words: ${words}, Limit: ${limit}`);

    if (charCount) {
        charCount.textContent = `${length} / ${limit} ${getT('inx.characters', 'caracteres')}`;
    }
    if (wordCount) {
        wordCount.textContent = `${words} ${getT('inx.words', 'palabras')}`;
    }
    
    if (length > limit) {
        charLimitWarning?.classList.remove('hidden');
        if (charCount) charCount.style.color = '#ef4444';
        console.log('Highlighting overflow...');
        highlightOverflow(limit, length);
    } else {
        charLimitWarning?.classList.add('hidden');
        if (charCount) charCount.style.color = '';
        removeOverflow();
    }
  }

  function highlightOverflow(limit: number, length: number) {
      console.log('highlightOverflow called', {limit, length});
      quill.off('text-change', handleTextChange);
      const range = quill.getSelection();
      
      // First clear it from EVERYTHING to avoid artifacts
      quill.formatText(0, quill.getLength(), 'overflow', false);
      
      // Then apply it ONLY to the excess
      if (length > limit) {
          console.log(`Applying overflow format from ${limit} for ${length - limit} chars`);
          quill.formatText(limit, length - limit, 'overflow', true);
      }
      
      if (range) quill.setSelection(range);
      quill.on('text-change', handleTextChange);
  }

  function removeOverflow() {
      console.log('removeOverflow called');
      quill.off('text-change', handleTextChange);
      quill.formatText(0, quill.getLength(), 'overflow', false);
      quill.on('text-change', handleTextChange);
  }

  // URL Synchronization Logic
  function deltaToMarkdown(delta: any) {
      let markdown = '';
      delta.ops.forEach((op: any) => {
          if (typeof op.insert !== 'string') return;
          let text = op.insert;
          if (op.attributes) {
              if (op.attributes.bold) text = `**${text}**`;
              if (op.attributes.italic) text = `_${text}_`;
              if (op.attributes.underline) text = `<u>${text}</u>`;
              if (op.attributes.strike) text = `~~${text}~~`;
              if (op.attributes.code) text = `\`${text}\``;
              
              // Custom styles
              if (op.attributes.script) text = `[s]${text}[/s]`;
              if (op.attributes.gothic) text = `[g]${text}[/g]`;
              if (op.attributes.doublestruck) text = `[d]${text}[/d]`;
          }
          markdown += text;
      });
      return markdown;
  }

  function applyMarkdownToQuill(markdown: string) {
      quill.setText('');
      const regex = /(\*\*|_|~~|<u>|<\/u>|`|\[s\]|\[\/s\]|\[g\]|\[\/g\]|\[d\]|\[\/d\])/g;
      const parts = markdown.split(regex);
      let currentAttributes: any = {};
      
      parts.forEach(part => {
          if (!part) return;
          if (part === '**') { currentAttributes.bold = !currentAttributes.bold; return; }
          if (part === '_') { currentAttributes.italic = !currentAttributes.italic; return; }
          if (part === '<u>') { currentAttributes.underline = true; return; }
          if (part === '</u>') { currentAttributes.underline = false; return; }
          if (part === '~~') { currentAttributes.strike = !currentAttributes.strike; return; }
          if (part === '`') { currentAttributes.code = !currentAttributes.code; return; }
          if (part === '[s]') { currentAttributes.script = true; return; }
          if (part === '[/s]') { currentAttributes.script = false; return; }
          if (part === '[g]') { currentAttributes.gothic = true; return; }
          if (part === '[/g]') { currentAttributes.gothic = false; return; }
          if (part === '[d]') { currentAttributes.doublestruck = true; return; }
          if (part === '[/d]') { currentAttributes.doublestruck = false; return; }
          
          const activeAttrs: any = { ...currentAttributes };
          quill.insertText(quill.getLength() - 1, part, activeAttrs);
      });
  }

  let urlSyncTimeout: ReturnType<typeof setTimeout>;
  function updateURL() {
      clearTimeout(urlSyncTimeout);
      urlSyncTimeout = setTimeout(() => {
          const delta = quill.getContents();
          const markdown = deltaToMarkdown(delta);
          const url = new URL(window.location.href);
          const currentT = url.searchParams.get('t');
          if (markdown.trim() === currentT?.trim() && !(!markdown.trim() && currentT)) return;

          if (markdown.trim()) {
              url.searchParams.set('t', markdown);
          } else {
              url.searchParams.delete('t');
          }
          window.history.replaceState({}, '', url.toString());
      }, 800);
  }

  function handleTextChange() {
      updateCounts();
      updateURL();
  }

  quill.on('text-change', handleTextChange);
  
  // Pro Toggle
  proToggle?.addEventListener('click', () => {
      isPro = !isPro;
      if (isPro) proToggle.classList.add('active');
      else proToggle.classList.remove('active');
      updateCounts();
  });

  // Initial Load from URL
  const params = new URLSearchParams(window.location.search);
  const initialMarkdown = params.get('t');
  if (initialMarkdown) {
      applyMarkdownToQuill(initialMarkdown);
  }
  updateCounts();
  
  // Custom Format Handlers
  customBtns.forEach(btn => {
      btn.addEventListener('click', () => {
          const variant = (btn as HTMLElement).dataset.variant;
          if (!variant) return;
          const range = quill.getSelection();
          if (range && range.length > 0) {
              const text = quill.getText(range.index, range.length);
              const converted = toUnicodeVariant(text, variant);
              quill.deleteText(range.index, range.length);
              quill.insertText(range.index, converted);
              quill.setSelection(range.index, converted.length);
          }
      });
  });

  formatBtns.forEach(btn => {
      btn.addEventListener('click', () => {
          const format = (btn as HTMLElement).dataset.format;
          if (!format) return;
          if (format === 'clean') {
               const range = quill.getSelection();
               if (range && range.length > 0) {
                   const text = quill.getText(range.index, range.length);
                   const normalized = unicodeToAscii(text);
                   if (text !== normalized) {
                       quill.deleteText(range.index, range.length);
                       quill.insertText(range.index, normalized);
                       quill.setSelection(range.index, normalized.length);
                   }
                   quill.removeFormat(range.index, range.length);
               }
          } else {
             const currentFormats = quill.getFormat();
             quill.format(format, !currentFormats[format]);
          }
      });
  });

  quill.on('editor-change', (eventName, ...args) => {
      if (eventName === 'selection-change') {
          const range = args[0];
          if (range) {
              const formats = quill.getFormat(range);
              formatBtns.forEach(btn => {
                  const format = (btn as HTMLElement).dataset.format;
                  if (format && format !== 'clean') {
                      if (formats[format]) btn.classList.add('active');
                      else btn.classList.remove('active');
                  }
              });
          }
      }
  });

  copyBtn?.addEventListener('click', async () => {
      const delta = quill.getContents();
      const unicodeText = deltaToUnicode(delta);
      try {
        await navigator.clipboard.writeText(unicodeText);
        if (copyLabel) copyLabel.textContent = getT('inlinked.copied', 'Copiado');
        if (copyBtn) copyBtn.classList.add('success');
        setTimeout(() => {
            if (copyLabel) copyLabel.textContent = getT('inlinked.copy', 'Copiar');
            if (copyBtn) copyBtn.classList.remove('success');
        }, 2000);
      } catch (err) {
        alert(getT('inlinked.error_copy', 'No se pudo copiar el texto.'));
      }
  });

  clearBtn?.addEventListener('click', () => {
      if (confirm(getT('inlinked.confirm_clear', '¿Borrar todo el texto?'))) {
          quill.setText('');
      }
  });
  
  const style = document.createElement('style');
  style.textContent = `
    #toolbar .ribbon-btn.success { color: #16a34a; background: #dcfce7; }
  `;
  document.head.appendChild(style);

  window.insertInVisualEditor = (text: string) => {
       const selection = quill.getSelection(true);
       quill.insertText(selection.index, text);
  };
</script>