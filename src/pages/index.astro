---
import InSuiteLanding from '../components/InSuiteLanding.astro';
import LayoutInSuite from '../layouts/LayoutInSuite.astro';
import { INSUITE_COPY } from '../data/insuite';

const copy = INSUITE_COPY.en;
---

<LayoutInSuite lang="en" title={copy.meta.title} description={copy.meta.description} path="/">
	<script slot="head" is:inline>
		/*
		 * English is the default for a shared link. A browser that speaks Spanish
		 * is handed the Spanish page instead, unless the visitor already chose a
		 * language here (the switch stores that choice in `app_lang`).
		 */
		(function () {
			try {
				var stored = localStorage.getItem('app_lang');
				var preferred = stored === 'en' || stored === 'es' ? stored : '';
				if (!preferred) {
					var langs =
						navigator.languages && navigator.languages.length
							? navigator.languages
							: [navigator.language || ''];
					preferred = (langs[0] || '').toLowerCase().indexOf('es') === 0 ? 'es' : 'en';
				}
				if (preferred === 'es' && location.pathname === '/') {
					location.replace('/es/' + location.search + location.hash);
				}
			} catch (e) {}
		})();
	</script>

	<InSuiteLanding locale="en" />
</LayoutInSuite>
