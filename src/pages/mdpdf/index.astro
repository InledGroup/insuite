---
import Sidebar from "../../components/sidebar.astro";
import Layout from "../../layouts/LayoutEditors.astro";
---

<Layout i18nTitle="mdpdf.title">
    <html lang="es">
        <head>
            <meta charset="UTF-8" />
            <meta
                name="viewport"
                content="width=device-width, initial-scale=1.0"
            />
            <title>Free Markdown to PDF Editor</title>
            <link rel="shortcut icon" type="image/x-icon" href="favicon.ico" />
            <script
                src="https://kit.fontawesome.com/4bf0ac964c.js"
                crossorigin="anonymous"></script>

            <link rel="stylesheet" href="/mdpdf/style.css" />
            <script is:inline src="/mdpdf/_script.js"></script>

            <!-- Solo las librerías esenciales -->
            <script
                src="https://cdn.jsdelivr.net/npm/marked@4.0.10/marked.min.js"
            ></script>

            <!-- MathJax configuración limpia -->
            <script>
                window.MathJax = {
                    tex: {
                        inlineMath: [["$", "$"]],
                        displayMath: [["$$", "$$"]],
                        processEscapes: true,
                    },
                    options: {
                        skipHtmlTags: [
                            "script",
                            "noscript",
                            "style",
                            "textarea",
                            "pre",
                        ],
                    },
                };
            </script>
            <script
                id="MathJax-script"
                async
                src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
            ></script>

            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link
                rel="preconnect"
                href="https://fonts.gstatic.com"
                crossorigin
            />
            <link
                href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
                rel="stylesheet"
            />

            <style></style>
        </head>
        <body>
            <div class="container">
                <Sidebar />

                <div class="header">
                    <img
                        src="https://hosted.inled.es/MDPDF.png"
                        alt="LogoMDPDF"
                        class="logo"
                    />
                    <div class="header-name">
                        <h1 data-i18n="mdpdf.header">MDPDF</h1>
                    </div>
                    <button class="btn mobile-toggle" id="btn-toggle-preview" style="display: none;">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                    <div class="header-info">
                        <a href="https://github.com/Inled-Group/mdpdf">GitHub</a
                        >
                    </div>
                </div>

                <div class="ribbon">
                    <div class="ribbon-group">
                        <button class="btn btn-primary" id="btn-export">
                            <i class="fa-solid fa-file-pdf"></i><span data-i18n="mdpdf.export">Exportar a PDF</span>
                        </button>
                        <button class="btn" id="btn-example">
                            <i class="fa-solid fa-file-lines"></i><span data-i18n="mdpdf.example">Insertar ejemplo</span>
                        </button>
                    </div>

                    <a href="/apps" class="ribbon-logo">
                        <img src="https://hosted.inled.es/insuite.svg" alt="Insuite" />
                    </a>

                    <div class="ribbon-group">
                        <button class="btn mobile-toggle" id="btn-toggle-preview">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <button class="btn" id="btn-clear">
                            <i class="fa-solid fa-trash"></i><span data-i18n="mdpdf.clear_all">Limpiar todo</span>
                        </button>
                    </div>
                </div>

                <div class="main-content">
                    <div class="editor-panel">
                        <div class="panel-header" data-i18n="mdpdf.editor">Editor</div>
                        <textarea
                            id="markdown-input"
                            placeholder="# Mi Documento..."
                            data-i18n-placeholder="mdpdf.placeholder"
                        ></textarea>
                    </div>

                    <div class="preview-panel">
                        <div class="panel-header" data-i18n="mdpdf.preview">Vista previa</div>
                        <div id="preview"></div>
                        <div class="ribbon">
                             <button class="btn mobile-toggle" id="btn-toggle-preview-close">
                                <i class="fa-solid fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Modal de Bienvenida -->
                <div id="welcome-modal" class="loading" style="display: flex; background: rgba(0,0,0,0.8); z-index: 5000;">
                    <div style="background: white; padding: 30px; border-radius: 10px; color: #333; max-width: 80%; text-align: center;">
                        <h2>¡Bienvenido a MDPDF!</h2>
                        <p>Convierte tus notas Markdown a PDF profesional.</p>
                        <button class="btn btn-primary" id="btn-close-welcome" style="margin: 20px auto 0;">Empezar</button>
                    </div>
                </div>

                <div class="status-bar">
                    <a href="https://github.com/Inled-Group/mdpdf/issues" data-i18n="mdpdf.report"
                        >Reportar error</a
                    >
                    <span id="word-count">0 <span data-i18n="mdoxc.words">palabras</span></span>
                </div>
            </div>

            <div class="loading" id="loading">
                <div class="spinner"></div>
                <p data-i18n="mdpdf.generating">Generando PDF...</p>
            </div>

            <script></script>
        </body>
    </html>
</Layout>
