---
import Sidebar from "../../components/sidebar.astro";
import Layout from "../../layouts/LayoutEditors.astro";
import Editor from "../../components/inlinked/Editor.astro";
---

<Layout
  title="Inlinked | Formateador de texto para LinkedIN"
  description="Formatea texto para LinkedIN"
  i18nTitle="inlinked.title"
>
  <div class="app-container">
    <Sidebar />
    
    <main class="main-content">
      <header class="top-bar">
         <div class="brand">
             <img src="https://hosted.inled.es/cdn/insuite.svg" alt="" width="24" height="24" />
             <h1 data-i18n="inlinked.header">Inlinked</h1>
         </div>
      </header>
      
      <div class="content-wrapper">
          <Editor platform="linkedin" />
          
          <div class="docs-section">
            <details class="url-docs">
                <summary data-i18n="inlinked.docs_title">Cómo formatear vía URL</summary>
                <div class="docs-content">
                    <p data-i18n="inlinked.docs_desc">Puedes compartir textos formateados usando el parámetro <code>?t=</code> en la URL:</p>
                    <div class="grid-docs">
                        <div class="doc-item"><code>**negrita**</code> <span>&rarr;</span> <strong>negrita</strong></div>
                        <div class="doc-item"><code>_cursiva_</code> <span>&rarr;</span> <em>cursiva</em></div>
                        <div class="doc-item"><code>&lt;u&gt;subr.&lt;/u&gt;</code> <span>&rarr;</span> <u>subrayado</u></div>
                        <div class="doc-item"><code>~~tachado~~</code> <span>&rarr;</span> <del>tachado</del></div>
                        <div class="doc-item"><code>`código`</code> <span>&rarr;</span> <code>código</code></div>
                        <div class="doc-item"><code>[s]script[/s]</code> <span>&rarr;</span> <span style="font-family: serif; font-style: italic;">Script</span></div>
                        <div class="doc-item"><code>[g]gothic[/g]</code> <span>&rarr;</span> <span style="font-family: serif;">Gothic</span></div>
                        <div class="doc-item"><code>[d]double[/d]</code> <span>&rarr;</span> <span style="font-family: serif; letter-spacing: 1px;">Dｏｕｂｌｅ</span></div>
                    </div>
                    <button id="copySkillBtn" class="copy-skill-btn">Copy AI skill</button>
                </div>
            </details>
          </div>

          <script is:inline>
            document.getElementById('copySkillBtn')?.addEventListener('click', async () => {
              const skill = `# Skill: Formatear posts para InLinked (LinkedIn) via URL

Cuando el usuario te pida formatear un post para LinkedIn, genera un enlace usando la siguiente plantilla.

## Base URL
https://insuite.inled.es/inlinked/

## Parámetro
?t= followed by the formatted text using the syntax below.

## Syntax

| Format | Syntax | Example |
|--------|--------|---------|
| Bold | \`**text**\` | \`**Hola mundo**\` |
| Italic | \`_text_\` | \`_Hola mundo_\` |
| Underline | \`<u>text</u>\` | \`<u>Hola mundo</u>\` |
| Strikethrough | \`~~text~~\` | \`~~Hola mundo~~\` |
| Code | \\\`text\\\` | \\\`code example\\\` |
| Script | \`[s]text[/s]\` | \`[s]Script[/s]\` |
| Gothic | \`[g]text[/g]\` | \`[g]Gothic[/g]\` |
| Double | \`[d]text[/d]\` | \`[d]Double[/d]\` |

## URL Example
\`\`\`
https://insuite.inled.es/inlinked/?t=**Hola** _mundo_ [s]script[/s]
\`\`\`

## Instructions
- Apply the formatting marks directly to the user's text.
- Return the full URL ready to open in a browser.
- When the text contains multiple formatting styles, combine them in a single ?t= parameter.
- Do not URL-encode the formatting characters.`;

              try {
                await navigator.clipboard.writeText(skill);
                const btn = document.getElementById('copySkillBtn');
                btn.textContent = '¡Copiado!';
                btn.classList.add('success');
                setTimeout(() => {
                  btn.textContent = 'Copiar skill para IA';
                  btn.classList.remove('success');
                }, 2000);
              } catch (err) {
                console.error('Error al copiar skill', err);
              }
            });
          </script>
      </div>

      <footer class="footer">
        <p data-i18n="footer.rights">Inled Group 2026. Licenciado bajo GNU GPLv3.0</p>
      </footer>
    </main>
  </div>
</Layout>

<style>
  html, body {
      height: 100%;
      margin: 0;
      background: var(--office-paper, #faf9f8);
      color: var(--office-ink, #201f1e);
      font-family: var(--office-font, 'Segoe UI', sans-serif);
  }

  .app-container {
    display: flex;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow-x: hidden;
  }

  .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1.5rem;
      background: var(--office-surface, #fff);
      border-bottom: 1px solid var(--office-line, #e1dfdd);
  }

  .brand {
      display: flex;
      align-items: center;
      gap: 10px;
  }

  .brand img { width: 24px; height: 24px; }

  .brand h1 {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      color: var(--office-ink, #201f1e);
      letter-spacing: -0.01em;
  }

  .content-wrapper {
      flex: 1;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      max-width: 1000px;
      margin: 0 auto;
      width: 100%;
      box-sizing: border-box;
  }

  .footer {
      padding: 1rem 1.5rem;
      text-align: center;
      color: var(--office-ink-4, #8a8886);
      font-size: 0.75rem;
      border-top: 1px solid var(--office-line, #e1dfdd);
      background: transparent;
  }

  /* Docs Styles */
  .docs-section { margin-top: 1.5rem; }

  .url-docs {
      background: var(--office-surface, #fff);
      border: 1px solid var(--office-line, #e1dfdd);
      border-radius: var(--office-radius, 4px);
      overflow: hidden;
      transition: box-shadow 0.2s ease;
  }

  .url-docs[open] { box-shadow: var(--office-shadow, 0 1px 2px rgba(0,0,0,0.08)); }

  .url-docs summary {
      padding: 12px 16px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      color: var(--office-ink, #201f1e);
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      user-select: none;
  }

  .url-docs summary::before {
      content: '→';
      display: inline-block;
      transition: transform 0.2s ease;
      color: var(--office-accent, #0f6cbd);
  }

  .url-docs[open] summary::before { transform: rotate(90deg); }

  .docs-content {
      padding: 0 16px 16px;
      border-top: 1px solid var(--office-line, #e1dfdd);
      color: var(--office-ink-3, #605e5c);
      font-size: 13px;
  }

  .docs-content p { margin: 1rem 0; }

  .grid-docs {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;
      margin-top: 0.75rem;
  }

  .doc-item {
      background: var(--office-paper, #faf9f8);
      padding: 10px 12px;
      border-radius: var(--office-radius, 4px);
      border: 1px solid var(--office-line, #e1dfdd);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
  }

  .doc-item code {
      background: var(--office-surface, #fff);
      padding: 2px 6px;
      border-radius: 3px;
      color: var(--office-accent, #0f6cbd);
      font-weight: 500;
      border: 1px solid var(--office-line, #e1dfdd);
  }

  .doc-item span { color: var(--office-ink-4, #8a8886); }

  .copy-skill-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
      padding: 7px 12px;
      background: var(--office-surface, #fff);
      color: var(--office-ink, #201f1e);
      border: 1px solid var(--office-line-strong, #d2d0ce);
      border-radius: var(--office-radius, 4px);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s ease;
      font-family: inherit;
  }

  .copy-skill-btn:hover {
      background: var(--office-surface-2, #f3f2f1);
      color: var(--office-ink, #201f1e);
      border-color: var(--office-line-strong, #d2d0ce);
  }

  .copy-skill-btn.success {
      border-color: #10b981;
      color: #107c41;
  }

  @media (max-width: 768px) {
    .app-container { flex-direction: column; }
    .top-bar { padding: 0.75rem 1rem; }
    .content-wrapper { padding: 1rem; }
  }
</style>
